{
  "$defs": {
    "ApiError": {
      "description": "The error half of the response envelope.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Structured, non-sensitive context, e.g. `{\"held_by\":\"RESTORE\"}`.",
          "type": "object"
        },
        "fields": {
          "description": "Present only for `VALIDATION_FAILED`.",
          "items": {
            "$ref": "#/$defs/FieldError"
          },
          "type": "array"
        },
        "message": {
          "description": "Written for a person. Never a stack trace, never a raw driver message.",
          "type": "string"
        },
        "request_id": {
          "description": "Correlates this failure with the agent log.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "type": "object"
    },
    "AuditEntry": {
      "description": "An audit entry. `target_label` is a copy rather than a join, so the record\nstill reads sensibly after the thing it describes has been deleted.",
      "properties": {
        "action": {
          "type": "string"
        },
        "client_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/AuditId"
        },
        "occurred_at": {
          "type": "string"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "$ref": "#/$defs/AuditResult"
        },
        "source_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "occurred_at",
        "action",
        "result"
      ],
      "type": "object"
    },
    "AuditId": {
      "description": "Identifier prefixed with `aud_`.",
      "type": "string"
    },
    "AuditResult": {
      "enum": [
        "SUCCESS",
        "FAILURE",
        "DENIED"
      ],
      "type": "string"
    },
    "Availability": {
      "description": "The five connectivity states from `docs/architecture.md` §8, as one\nreusable tri-state. `Unknown` is a real answer — probing may be disabled.",
      "enum": [
        "UNKNOWN",
        "AVAILABLE",
        "UNAVAILABLE"
      ],
      "type": "string"
    },
    "BackupId": {
      "description": "Identifier prefixed with `bkp_`.",
      "type": "string"
    },
    "BackupStatus": {
      "enum": [
        "PENDING",
        "CREATING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "CORRUPT"
      ],
      "type": "string"
    },
    "BackupSummary": {
      "properties": {
        "checksum_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/BackupId"
        },
        "includes_config": {
          "type": "boolean"
        },
        "includes_files": {
          "type": "boolean"
        },
        "includes_volumes": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/BackupStatus"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "status",
        "includes_files",
        "includes_volumes",
        "includes_config",
        "created_at"
      ],
      "type": "object"
    },
    "Connectivity": {
      "description": "The independent connectivity states from `docs/architecture.md` §8.\nDeliberately not collapsed into one flag: an unplugged cable and an\nunreachable agent need different remedies.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Availability"
        },
        "checked_at": {
          "type": "string"
        },
        "internet": {
          "$ref": "#/$defs/Availability"
        },
        "lan": {
          "$ref": "#/$defs/Availability"
        }
      },
      "required": [
        "agent",
        "lan",
        "internet",
        "checked_at"
      ],
      "type": "object"
    },
    "ContainerEventSummary": {
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "$ref": "#/$defs/ContainerEventType"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "occurred_at": {
          "type": "string"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "project_id",
        "event_type",
        "occurred_at"
      ],
      "type": "object"
    },
    "ContainerEventType": {
      "enum": [
        "CREATED",
        "STARTED",
        "STOPPED",
        "RESTARTED",
        "DIED",
        "OOM_KILLED",
        "HEALTH_PASS",
        "HEALTH_FAIL",
        "DESTROYED"
      ],
      "type": "string"
    },
    "CreateProjectRequest": {
      "description": "What the creation wizard submits. The server generates the identifier, slug,\ndirectory and container name; none of them derive from `display_name`.",
      "properties": {
        "autostart": {
          "type": "boolean"
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "environment": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnvVarInput"
          },
          "type": "array"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "$ref": "#/$defs/NetworkConfigRequest"
        },
        "project_type": {
          "$ref": "#/$defs/ProjectType"
        },
        "resources": {
          "$ref": "#/$defs/ResourceLimits",
          "default": {
            "cpu_limit_cores": 1.0,
            "memory_limit_mb": 512,
            "process_limit": 128,
            "storage_limit_mb": 2048
          }
        },
        "restart_policy": {
          "$ref": "#/$defs/RestartPolicy"
        },
        "runtime_config": {
          "$ref": "#/$defs/RuntimeConfig"
        },
        "source": {
          "$ref": "#/$defs/ProjectSource"
        }
      },
      "required": [
        "display_name",
        "project_type",
        "source",
        "runtime_config",
        "network",
        "autostart",
        "restart_policy"
      ],
      "type": "object"
    },
    "DeleteProjectRequest": {
      "description": "Deleting requires echoing the display name. The confirmation is part of the\ncontract, not a dialog the API would happily let a caller skip.",
      "properties": {
        "confirm_name": {
          "type": "string"
        },
        "remove_volumes": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "confirm_name"
      ],
      "type": "object"
    },
    "DeploymentId": {
      "description": "Identifier prefixed with `dep_`.",
      "type": "string"
    },
    "DeploymentStatus": {
      "enum": [
        "PENDING",
        "BUILDING",
        "STARTING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED"
      ],
      "type": "string"
    },
    "DeploymentSummary": {
      "properties": {
        "deployment_type": {
          "$ref": "#/$defs/DeploymentType"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/DeploymentId"
        },
        "image_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "started_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DeploymentStatus"
        }
      },
      "required": [
        "id",
        "project_id",
        "deployment_type",
        "status",
        "started_at"
      ],
      "type": "object"
    },
    "DeploymentType": {
      "enum": [
        "INITIAL",
        "REBUILD",
        "RESTORE",
        "CONFIG_CHANGE",
        "IMPORT"
      ],
      "type": "string"
    },
    "DesiredState": {
      "description": "What the user asked for. Survives restarts; the reconciler converges\nobserved state towards it.",
      "enum": [
        "RUNNING",
        "STOPPED",
        "ARCHIVED"
      ],
      "type": "string"
    },
    "EnvVarId": {
      "description": "Identifier prefixed with `env_`.",
      "type": "string"
    },
    "EnvVarInput": {
      "properties": {
        "is_secret": {
          "default": false,
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "EnvVarSummary": {
      "description": "A variable as the API returns it.\n\nFor a secret, `value` is always `None` and `is_set` reports whether one has\nbeen stored. There is no representation in which a secret's value travels to\na client.",
      "properties": {
        "id": {
          "$ref": "#/$defs/EnvVarId"
        },
        "is_secret": {
          "type": "boolean"
        },
        "is_set": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "restart_required": {
          "type": "boolean"
        },
        "updated_at": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "key",
        "is_secret",
        "is_set",
        "restart_required",
        "updated_at"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Machine-readable outcome. Stable across releases.",
      "oneOf": [
        {
          "const": "VALIDATION_FAILED",
          "description": "Request body failed schema validation.",
          "type": "string"
        },
        {
          "const": "UNAUTHENTICATED",
          "description": "Missing or invalid credentials.",
          "type": "string"
        },
        {
          "const": "SESSION_EXPIRED",
          "description": "Valid token, past its expiry.",
          "type": "string"
        },
        {
          "const": "FORBIDDEN",
          "description": "Authenticated but not permitted.",
          "type": "string"
        },
        {
          "const": "NOT_FOUND",
          "description": "No such resource.",
          "type": "string"
        },
        {
          "const": "CONFLICT",
          "description": "Violates a uniqueness or state constraint.",
          "type": "string"
        },
        {
          "const": "PROJECT_LOCKED",
          "description": "Another operation holds this project's lock.",
          "type": "string"
        },
        {
          "const": "OPERATION_IN_PROGRESS",
          "description": "An identical idempotent request is still running.",
          "type": "string"
        },
        {
          "const": "PRECONDITION_FAILED",
          "description": "State precondition not met, e.g. restore on a running project.",
          "type": "string"
        },
        {
          "const": "PAYLOAD_TOO_LARGE",
          "description": "Upload exceeds the configured limit.",
          "type": "string"
        },
        {
          "const": "RATE_LIMITED",
          "description": "Too many requests.",
          "type": "string"
        },
        {
          "const": "PORT_UNAVAILABLE",
          "description": "Requested host port is taken or out of range.",
          "type": "string"
        },
        {
          "const": "RESOURCE_LIMIT_EXCEEDED",
          "description": "A configured ceiling would be exceeded.",
          "type": "string"
        },
        {
          "const": "ARCHIVE_REJECTED",
          "description": "The archive failed a security check.",
          "type": "string"
        },
        {
          "const": "PATH_REJECTED",
          "description": "The path escaped the project root.",
          "type": "string"
        },
        {
          "const": "INTEGRITY_CHECK_FAILED",
          "description": "Checksum or archive integrity mismatch.",
          "type": "string"
        },
        {
          "const": "SETUP_REQUIRED",
          "description": "No administrator exists yet.",
          "type": "string"
        },
        {
          "const": "AGENT_STARTING",
          "description": "Migrations or reconciliation still running.",
          "type": "string"
        },
        {
          "const": "INTERNAL",
          "description": "Unexpected failure. Details are in the agent log only.",
          "type": "string"
        }
      ]
    },
    "FieldError": {
      "description": "One field that failed validation.",
      "properties": {
        "field": {
          "description": "Dotted path to the offending field, e.g. `resources.memory_limit_mb`.",
          "type": "string"
        },
        "message": {
          "description": "Why it was rejected, phrased for a person.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ],
      "type": "object"
    },
    "HealthCheckConfig": {
      "properties": {
        "interval_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/HealthCheckType"
        },
        "retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_period_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "interval_seconds",
        "timeout_seconds",
        "retries",
        "start_period_seconds"
      ],
      "type": "object"
    },
    "HealthCheckType": {
      "enum": [
        "NONE",
        "HTTP",
        "TCP",
        "COMMAND"
      ],
      "type": "string"
    },
    "HealthState": {
      "description": "`None` means the workload has no meaningful check — a Discord bot serves\nnothing. Inventing a check that always passes would be worse than saying so.",
      "enum": [
        "UNKNOWN",
        "STARTING",
        "HEALTHY",
        "UNHEALTHY",
        "NONE"
      ],
      "type": "string"
    },
    "HostMetrics": {
      "properties": {
        "cpu_percent": {
          "format": "float",
          "type": "number"
        },
        "cpu_temperature_c": {
          "description": "`None` where the platform does not expose it, which is common on Windows.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "disk_read_bytes_per_sec": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "disk_total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "disk_used_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "disk_write_bytes_per_sec": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_used_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "net_rx_bytes_per_sec": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "net_tx_bytes_per_sec": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "process_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sampled_at": {
          "type": "string"
        },
        "swap_total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "swap_used_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "uptime_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sampled_at",
        "cpu_percent",
        "memory_used_bytes",
        "memory_total_bytes",
        "swap_used_bytes",
        "swap_total_bytes",
        "disk_used_bytes",
        "disk_total_bytes",
        "disk_read_bytes_per_sec",
        "disk_write_bytes_per_sec",
        "net_rx_bytes_per_sec",
        "net_tx_bytes_per_sec",
        "process_count",
        "uptime_seconds"
      ],
      "type": "object"
    },
    "LogLine": {
      "properties": {
        "message": {
          "type": "string"
        },
        "stream": {
          "description": "`stdout` or `stderr`. Kept distinct so the UI can colour and filter them.",
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "stream",
        "message"
      ],
      "type": "object"
    },
    "LoginRequest": {
      "properties": {
        "client_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "password"
      ],
      "type": "object"
    },
    "LoginResponse": {
      "description": "The token is returned exactly once, to the desktop client's Rust core, which\nputs it in the OS keychain. It never reaches the webview.",
      "properties": {
        "expires_at": {
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "token": {
          "type": "string"
        },
        "user": {
          "$ref": "#/$defs/UserSummary"
        }
      },
      "required": [
        "token",
        "session_id",
        "user",
        "expires_at"
      ],
      "type": "object"
    },
    "NetworkConfig": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/NetworkMode"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/PortMapping"
          },
          "type": "array"
        }
      },
      "required": [
        "mode",
        "ports"
      ],
      "type": "object"
    },
    "NetworkConfigRequest": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/NetworkMode"
        },
        "ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PortRequest"
          },
          "type": "array"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "NetworkMode": {
      "description": "Per-project network reach. `Internal` is the default: a project gets a\ndedicated network with no outbound route until someone asks for more.",
      "enum": [
        "NONE",
        "INTERNAL",
        "LAN",
        "INTERNET"
      ],
      "type": "string"
    },
    "NotificationId": {
      "description": "Identifier prefixed with `ntf_`.",
      "type": "string"
    },
    "NotificationLevel": {
      "enum": [
        "INFO",
        "SUCCESS",
        "WARNING",
        "ERROR"
      ],
      "type": "string"
    },
    "NotificationSummary": {
      "properties": {
        "body": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/NotificationId"
        },
        "level": {
          "$ref": "#/$defs/NotificationLevel"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "title",
        "body",
        "created_at"
      ],
      "type": "object"
    },
    "OperationHandle": {
      "description": "Returned by any endpoint that starts background work.",
      "properties": {
        "accepted_at": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "operation_id",
        "project_id",
        "kind",
        "accepted_at"
      ],
      "type": "object"
    },
    "OperationId": {
      "description": "Identifier prefixed with `op_`.",
      "type": "string"
    },
    "PackageManager": {
      "enum": [
        "PNPM",
        "NPM",
        "YARN",
        "BUN",
        "DENO",
        "PIP",
        "POETRY",
        "UV",
        "PIPENV",
        "GO_MODULES",
        "CARGO",
        "MAVEN",
        "GRADLE",
        "COMPOSER",
        "BUNDLER",
        "NUGET",
        "NONE"
      ],
      "type": "string"
    },
    "PageRequest": {
      "description": "Query parameters for a paginated endpoint.",
      "properties": {
        "cursor": {
          "description": "The `next_cursor` from the previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Defaults to 50, clamped to `MAX_LIMIT`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
