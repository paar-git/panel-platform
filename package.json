{
  "name": "project-host",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "description": "Desktop application for hosting and managing projects on a private server",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contracts": "cargo run -p project-host-api-types --bin emit-contracts",
    "contracts:check": "cargo run -p project-host-api-types --bin emit-contracts -- --check",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:themes:update": "node scripts/update-theme-css.mjs",
    "test:watch": "vitest",
    "rust:test": "cargo test --workspace",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "verify": "pnpm contracts:check && pnpm rust:fmt:check && pnpm rust:lint && pnpm rust:test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
